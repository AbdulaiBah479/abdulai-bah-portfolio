# =====================================================================
# Bah.Digital environment file (TEMPLATE)
# Do not put real values here. Run:  ./scripts/setup.sh
# It copies this file to .env and fills every "CHANGE_ME" with a strong
# random secret. The .env file is ignored by Git.
# =====================================================================

COMPOSE_PROJECT_NAME=bah
TZ=Africa/Freetown

# ---- PostgreSQL (main database) ------------------------------------
POSTGRES_USER=bah_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bah

# Separate databases + users for each service (created automatically)
N8N_DB_PASSWORD=CHANGE_ME
LITELLM_DB_PASSWORD=CHANGE_ME

# ---- Qdrant (vector memory) ----------------------------------------
QDRANT_API_KEY=CHANGE_ME

# ---- n8n (automation) ----------------------------------------------
N8N_ENCRYPTION_KEY=CHANGE_ME

# ---- Open WebUI (chat interface) -----------------------------------
WEBUI_SECRET_KEY=CHANGE_ME

# ---- LiteLLM (AI gateway / model router) ---------------------------
# Master key = admin password for the gateway. Agents get their own keys later.
LITELLM_MASTER_KEY=CHANGE_ME
LITELLM_SALT_KEY=CHANGE_ME

# ---- Free cloud AI providers (optional, add when you reach Step 9) ---
# All have free tiers. Leave blank until you create the accounts.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- Claude API (optional, PAID per use) ----------------------------
# Note: a Claude Pro subscription does NOT include an API key.
# Leave blank unless you decide to buy API credits later.
ANTHROPIC_API_KEY=
